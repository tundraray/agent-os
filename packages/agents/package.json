    "test:verify": "vitest run --config ./vitest.config.verify.ts"
  },
  "dependencies": {
    "@agent-os/code-runner": "workspace:*",
    "@agent-os/common": "workspace:*",
    "@agent-os/contracts": "workspace:*",
    "@agent-os/db": "workspace:*",
    "@agent-os/runtime": "workspace:*",
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@mastra/core": "^1.80.0",
    "@modelcontextprotocol/client": "2.4.0",
    "drizzle-orm": "0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agent-os/mcp-fixture": "workspace:*",
    "@types/node": "^26.0.0",
    "fast-check": "^4.10.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
