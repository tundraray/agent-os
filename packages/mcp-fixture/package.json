{
  "name": "@agent-os/mcp-fixture",
  "version": "1.0.0",
  "description": "Fixture MCP server with synthetic payment logs and the research scenario ground truth",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings src/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "tsc -p tsconfig.json && node dist/generate-ground-truth.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
