{
  "name": "@agent-os/engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@agent-os/contracts": "workspace:*",
    "@agent-os/db": "workspace:*",
    "@agent-os/runtime": "workspace:*",
    "@agent-os/sources": "workspace:*",
    "@mastra/core": "^1.80.0",
    "drizzle-orm": "0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ai": "7.0.148",
    "fast-check": "^4.10.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
