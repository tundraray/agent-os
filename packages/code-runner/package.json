{
  "name": "@agent-os/code-runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:child": "tsc -p tsconfig.child.json",
    "test:e2e": "pnpm build && pnpm build:child && vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@agent-os/common": "workspace:*",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
