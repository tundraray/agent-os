{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": { "type": true, "interface": true },
  "ignoreIssues": {
    "apps/web/src/components/ui/**": ["exports", "types"],
    "apps/web/src/components/assistant-ui/**": ["exports", "types"],
    "apps/web/src/components/{file,image,media-player,surfaces}.tsx": ["exports", "types"]
  },
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/runtime/migrate-cli.ts"
      ],
      "ignoreDependencies": ["@nestjs/mau"]
    },
    "packages/agents": {
      "entry": [
        "src/index.ts",
        "src/testing.ts",
        "test/**/*.e2e-spec.ts"
      ]
    },
    "packages/mcp-fixture": {
      "entry": [
        "src/index.ts",
        "src/server.ts"
      ]
    },
    "packages/runtime": {
      "entry": [
        "src/index.ts",
        "test/support/runtimeChildMain.ts",
        "test/verify/**/*.verify.ts"
      ]
    }
  }
}
