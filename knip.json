{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": { "type": true, "interface": true },
  "ignoreIssues": {
    "apps/web/src/components/ui/**": ["exports", "types"],
    "apps/web/src/components/assistant-ui/**": ["exports", "types"],
    "apps/web/src/components/{file,image,media-player,surfaces}.tsx": [
      "exports",
      "types"
    ]
  },
  "workspaces": {
    ".": {
      "ignoreUnresolved": ["vitest/globals"]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/cli/migrate-cli.ts",
        "src/cli/super-admin-cli.ts",
        "src/cli/seed-mcp-cli.ts",
        "src/cli/seed-access-cli.ts",
        "test/verify/**/*.verify.ts",
        "rspack.config.js"
      ],
      "rspack": false,
      "ignoreDependencies": [
        "@nestjs/mau",
        "@ai-sdk/anthropic",
        "@ai-sdk/google",
        "@ai-sdk/openai-compatible",
        "@jitl/quickjs-wasmfile-release-sync",
        "@mastra/core",
        "drizzle-orm",
        "@modelcontextprotocol/client",
        "@modelcontextprotocol/server",
        "quickjs-emscripten-core"
      ]
    },
    "packages/agents": {
      "entry": [
        "test/**/*.e2e-spec.ts",
        "test/verify/**/*.verify.ts",
        "test/support/codeRunChildMain.ts"
      ]
    },
    "packages/code-runner": {
      "entry": [
        "src/executor/executor-main.ts",
        "test/**/*.e2e-spec.ts",
        "test/support/*-entry.ts"
      ]
    },
    "packages/runtime": {
      "entry": [
        "test/support/runtimeChildMain.ts",
        "test/verify/**/*.verify.ts"
      ]
    }
  }
}
