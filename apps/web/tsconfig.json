{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next and React: browser libraries, JSX, the Next plugin and the `@/` alias.
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": [],
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
