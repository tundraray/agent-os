# If host port 5432 is taken, start Postgres on another port (`POSTGRES_PORT=5433 pnpm db:up`)
# and use the same port here.
DATABASE_URL=postgres://agent:agent@localhost:5432/agent_os

# Model as "<provider>/<model>", e.g. anthropic/claude-opus-5-5, openai/gpt-5-5
ASSISTANT_MODEL=anthropic/claude-opus-5-5
# low | medium | high | xhigh | max
REASONING_EFFORT=medium
# Model for auto-generated thread titles; defaults to ASSISTANT_MODEL (also when empty). A fast,
# cheap model is recommended, e.g. anthropic/claude-haiku-5-5.
# TITLE_MODEL=anthropic/claude-haiku-5-5

# Keys for the providers you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

FRONTEND_ORIGIN=http://localhost:3000
PORT=4000

# Research runtime settings (design-runtime.md, Runtime Settings). Defaults shown; an invalid
# value stops the start naming the variable.
# off — no runtime workers (the e2e harness defaults to off)
RUNTIME_WORKERS=on
# Execution slots in the process
RUNTIME_CONCURRENCY=4
# Poll period of claim and deliveries, ms
RUNTIME_POLL_MS=500
# off — polling only, no LISTEN/NOTIFY wake-ups
RUNTIME_NOTIFY=on
# Task lease, heartbeat and reaper period, ms
RUNTIME_LEASE_MS=30000
RUNTIME_HEARTBEAT_MS=10000
RUNTIME_REAPER_MS=5000
# Recoveries before `recovery_exhausted`
RUNTIME_MAX_RECOVERIES=3
# Delivery attempts before `needs_attention` (backoff 1 s, doubling up to 60 s, jitter)
RUNTIME_DELIVERY_MAX_ATTEMPTS=5
# Wait for running tasks on graceful shutdown, ms
RUNTIME_SHUTDOWN_GRACE_MS=5000
# Size of the shared pg pool (PG_POOL)
DB_POOL_MAX=10
# Test-only crash point `<point>[:n]` — process.exit(137) on the n-th pass; ignored when
# NODE_ENV=production. Unset by default.
# RUNTIME_CRASH_AT=
