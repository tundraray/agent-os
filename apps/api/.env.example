# If host port 5432 is taken, start Postgres on another port (`POSTGRES_PORT=5433 pnpm db:up`)
# and use the same port here.
DATABASE_URL=postgres://agent:agent@localhost:5432/agent_os

# Provider key of the agents (Anthropic). The app starts without it, but every model call
# (chat answers, conversation titles) is refused by the provider.
ANTHROPIC_API_KEY=

FRONTEND_ORIGIN=http://localhost:3000
PORT=4000

# Sentry DSN; empty — nothing is sent to Sentry, logs go to the console only
SENTRY_DSN=
# Lowest log level: debug | info | warn | error
LOG_LEVEL=debug

# Task runtime settings (design-runtime.md, Runtime settings). Defaults shown; an invalid value
# stops the start naming the variable.
# off — no runtime workers (the e2e harness defaults to off)
RUNTIME_WORKERS=on
# Steps one instance runs at once
RUNTIME_CONCURRENCY=16
# Poll period of ready tasks and deliveries when no NOTIFY came, ms
RUNTIME_POLL_MS=500
# off — polling only, no LISTEN/NOTIFY wake-ups or interrupt signals
RUNTIME_NOTIFY=on
# Task lease, heartbeat and sweeper period, ms
RUNTIME_LEASE_MS=30000
RUNTIME_HEARTBEAT_MS=10000
RUNTIME_REAPER_MS=5000
# Losses of one step in a row before the task fails with `recovery_exhausted`
RUNTIME_MAX_RECOVERIES=3
# Limit of one step's duration, ms, at least 1000
RUNTIME_STEP_MS=900000
# How long a step may finish on graceful shutdown, ms
RUNTIME_SHUTDOWN_GRACE_MS=5000
# Delivery attempts of an event to a consumer
RUNTIME_DELIVERY_MAX_ATTEMPTS=5
# Size of the main pg pool and, separately, of the thread lock pool: an instance holds up to
# 2 x DB_POOL_MAX connections to Postgres
DB_POOL_MAX=10
# Max UTF-8 size of a queue message payload, bytes
INBOX_PAYLOAD_MAX_BYTES=1048576
# Model prices file, relative to apps/api (the working directory of the server); a missing or
# invalid file stops the start
MODEL_PRICES_FILE=config/model-prices.json
# Test-only crash point `<point>[:n]` — process.exit(137) on the n-th pass; ignored when
# NODE_ENV=production. Unset by default.
# RUNTIME_CRASH_AT=

# Agents settings (design-agents.md, Runtime settings). Defaults shown; an invalid value stops the
# start naming the variable. ANTHROPIC_API_KEY above is the agents' provider key too.
# Model when neither the launch nor the definition names one, also the chat's model and the
# conversation titles' model; must be in MODEL_PRICES_FILE
AGENT_DEFAULT_MODEL=anthropic/claude-haiku-5-5
AGENTS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Limit of one model answer, tokens
AGENT_MAX_OUTPUT_TOKENS=16000
# Largest depth of an agent; a conversation is at depth 0
AGENT_MAX_DEPTH=3
# A longer tool result is cut, bytes
AGENT_TOOL_RESULT_MAX_BYTES=16384
# Input tokens of the previous model call that start compaction
AGENT_COMPACT_AT_TOKENS=200000
# MCP servers file (id, command, args, env), relative to apps/api; a missing or invalid file stops
# the start. Ships with the fixture servers `logs` and `backoffice`, which run
# packages/mcp-fixture/dist/server.js: `pnpm turbo build --filter=api...` builds it. Env values are
# redacted in logs.
MCP_SERVERS_FILE=config/mcp-servers.json
# JSON "employee id -> server ids". `dev-user` is the employee every request runs as in development
# (SessionGuard; the `x-user-id` header names another). Empty — no employee has any server.
MCP_ACCESS_TABLE='{"dev-user":["logs","backoffice"]}'
# Limit of one MCP call, ms
MCP_CALL_TIMEOUT_MS=60000
