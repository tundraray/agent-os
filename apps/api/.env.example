DATABASE_URL=postgres://agent:agent@localhost:5432/agent_os

# Model as "<provider>/<model>", e.g. anthropic/claude-opus-5-5, openai/gpt-5-5
ASSISTANT_MODEL=anthropic/claude-opus-5-5
# low | medium | high | xhigh | max
REASONING_EFFORT=medium
# Model for auto-generated thread titles; defaults to ASSISTANT_MODEL. A fast, cheap model is
# recommended, e.g. anthropic/claude-haiku-5-5. Leave commented out (not empty) to use the default.
# TITLE_MODEL=anthropic/claude-haiku-5-5

# Keys for the providers you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
