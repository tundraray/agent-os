# If host port 5432 is taken, start Postgres on another port (`POSTGRES_PORT=5433 pnpm db:up`)
# and use the same port here.
DATABASE_URL=postgres://agent:agent@localhost:5432/agent_os

# Model as "<provider>/<model>", e.g. anthropic/claude-opus-5-5, openai/gpt-5-5
ASSISTANT_MODEL=anthropic/claude-opus-5-5
# low | medium | high | xhigh | max
REASONING_EFFORT=medium
# Model for auto-generated thread titles; defaults to ASSISTANT_MODEL (also when empty). A fast,
# cheap model is recommended, e.g. anthropic/claude-haiku-5-5.
# TITLE_MODEL=anthropic/claude-haiku-5-5

# Keys for the providers you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Research engine (design-engine.md, Runtime settings): Anthropic base for the engine's role models and token
# counts — the base WITHOUT the API version (the engine adds /v1). Default https://api.anthropic.com; an invalid
# value stops the start. Separate from ANTHROPIC_BASE_URL, which Mastra reads for the chat agent as a versioned base.
# RESEARCH_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Days a model-call transcript of an employee's investigation is kept (design-self-check.md, Runtime settings): once
# an hour the server deletes older transcripts, keeping those of `system:self-check` investigations and of calls
# outside an investigation; the call journal with its spend stays. Default 30; a value that is not a whole number not
# less than 1 stops the start naming the variable.
# TRANSCRIPT_RETENTION_DAYS=30
#
# The self-check program (`pnpm --filter api self-check`) has no database of its own: it works on DATABASE_URL, the
# server's database. Run it on a developer's database while the server's runtime workers are off and no employee
# investigation is unfinished (design-self-check.md, KD-3); the program does not check this.

FRONTEND_ORIGIN=http://localhost:3000
PORT=4000

# Research runtime settings (design-runtime.md, Runtime Settings). Defaults shown; an invalid
# value stops the start naming the variable.
# off — no runtime workers (the e2e harness defaults to off)
RUNTIME_WORKERS=on
# Execution slots in the process
RUNTIME_CONCURRENCY=4
# Poll period of claim and deliveries, ms
RUNTIME_POLL_MS=500
# off — polling only, no LISTEN/NOTIFY wake-ups
RUNTIME_NOTIFY=on
# Task lease, heartbeat and reaper period, ms
RUNTIME_LEASE_MS=30000
RUNTIME_HEARTBEAT_MS=10000
RUNTIME_REAPER_MS=5000
# Recoveries before `recovery_exhausted`
RUNTIME_MAX_RECOVERIES=3
# Delivery attempts before `needs_attention` (backoff 1 s, doubling up to 60 s, jitter)
RUNTIME_DELIVERY_MAX_ATTEMPTS=5
# Wait for running tasks on graceful shutdown, ms
RUNTIME_SHUTDOWN_GRACE_MS=5000
# Task limits (design-lifecycle.md, Runtime settings), ms, at least 1000. Wait of a ready task for
# its first claim, and one attempt; each is capped by the task deadline.
RUNTIME_QUEUE_WAIT_MS=600000
RUNTIME_ATTEMPT_MS=900000
# Size of the shared pg pool (PG_POOL) and, separately, of the thread lock pool: an instance holds up to
# 2 x DB_POOL_MAX connections to Postgres
DB_POOL_MAX=10
# Test-only crash point `<point>[:n]` — process.exit(137) on the n-th pass; ignored when
# NODE_ENV=production. Unset by default.
# RUNTIME_CRASH_AT=

# Deep research from chat (design-chat-entry.md, Runtime settings). Defaults shown; an invalid value
# stops the start naming the variable.
# How long after the first failed answer write the delivery loop keeps retrying before the launch fails, ms
# (pause between attempts: RUNTIME_POLL_MS doubling up to 16 times it)
RESEARCH_APPEND_GIVE_UP_MS=300000
# After how long the delivery loop finishes a launch left in `launching` by a crash, ms
RESEARCH_LAUNCH_RECOVERY_MS=60000

# Sources settings (design-mcp-source.md, Settings). Defaults shown; an invalid value stops the start.
# Call and snapshot-read timeout before the task deadline caps it, ms
SOURCE_CALL_TIMEOUT_MS=30000
# Full jitter backoff: a random delay in [0, min(cap, base × 2^n)], ms
SOURCE_RETRY_BASE_MS=200
SOURCE_RETRY_CAP_MS=5000
# Pages per fetch task
SOURCE_MAX_PAGES=1000
# Fixture data version at process start: v1 | v2
FIXTURE_DATASET=v1
# Fault rules and call journal of the fixture process; unset by default. Rules without a journal
# stop the start.
# FIXTURE_FAULTS=
# FIXTURE_CALL_LOG=
