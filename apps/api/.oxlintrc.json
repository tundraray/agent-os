{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["src/research/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@mastra/*", "@mastra/**"],
                "message": "ADR-0001: the research runtime must not depend on Mastra."
              }
            ]
          }
        ]
      }
    }
  ]
}
