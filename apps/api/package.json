{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --exec \"node --disable-sigusr1\"",
    "start:dev": "nest start --watch --exec \"node --disable-sigusr1\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --disable-sigusr1 dist/main",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:verify": "pnpm --filter \"api^...\" build && vitest run --config ./vitest.config.verify.ts",
    "dev": "nest start --watch --exec \"node --disable-sigusr1\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node --env-file-if-exists=.env dist/runtime/migrate-cli.js"
  },
  "dependencies": {
    "@agent-os/agents": "workspace:*",
    "@agent-os/common": "workspace:*",
    "@agent-os/contracts": "workspace:*",
    "@agent-os/db": "workspace:*",
    "@agent-os/runtime": "workspace:*",
    "@agent-os/workflows": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@sentry/nestjs": "^11.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agent-os/mcp-fixture": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "fast-check": "^4.10.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
