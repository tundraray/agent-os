    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:verify": "vitest run --config ./vitest.config.verify.ts",
    "dev": "nest start --watch --exec \"node --disable-sigusr1\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env dist/migrate-cli.js",
    "identity:super-admin": "node --env-file-if-exists=.env dist/super-admin-cli.js",
    "seed:mcp": "node --env-file-if-exists=.env dist/seed-mcp-cli.js",
    "seed:access": "node --env-file-if-exists=.env dist/seed-access-cli.js"
  },
